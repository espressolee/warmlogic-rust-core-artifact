# Dashboard dev defaults (copy to .env and override locally)
WARMLOGIC_DASH_HOST=127.0.0.1
WARMLOGIC_DASH_PORT=8050
WARMLOGIC_DASH_THEME=light
WARMLOGIC_DASH_DEBUG=1
# Light mode skips heavier reflective loaders for faster boot
WARMLOGIC_BOOTSTRAP_MODE=light
WARMLOGIC_COLLAPSE_OPERATOR=false
WARMLOGIC_COLLAPSE_DEVLOOP=false

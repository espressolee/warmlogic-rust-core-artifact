FROM python:3.11-slim

LABEL org.opencontainers.image.title="WarmLogic Core"
LABEL org.opencontainers.image.description="Compatibility Dockerfile for CI paths expecting repo-root Dockerfile.core"

WORKDIR /app

COPY src ./src
COPY pyproject.toml README.md ./

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

CMD ["python", "-m", "warm_logic.app.cli.wlctl", "--help"]


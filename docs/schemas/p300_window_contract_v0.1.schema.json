{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["window"],
  "properties": {
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "end": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "policy": { "type": "string" }
  },
  "additionalProperties": true
}

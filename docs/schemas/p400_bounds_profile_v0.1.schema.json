{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["bounds"],
  "properties": {
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "additionalProperties": true
    },
    "profile": { "type": "string" }
  },
  "additionalProperties": true
}

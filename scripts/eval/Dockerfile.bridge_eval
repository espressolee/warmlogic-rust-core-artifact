FROM rust:1.93

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    patchelf \
    pkg-config \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip \
  && /opt/venv/bin/python -m pip install --no-cache-dir maturin==1.11.5

ENV PATH="/opt/venv/bin:/usr/local/cargo/bin:${PATH}"

WORKDIR /work

ENTRYPOINT ["bash", "-c"]
